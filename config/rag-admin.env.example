# Example rag-admin env for /opt/ai/config/rag-admin.env
# Install: cp config/rag-admin.env.example /opt/ai/config/rag-admin.env
#
# Production typical: Qwen embed-pool (2560-d) on a GPU/API host.
# Match EMBED_URL / QDRANT_* with rag-proxy.env on the same collection.

EMBED_URL=http://127.0.0.1:8081
EMBED_MODEL=embed-pool
EMBED_ON_DEMAND=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=nomad_knowledge_base_qwen3
QDRANT_VECTOR_SIZE=2560

# Legacy nomic systemd (768-d) — only if still on that collection:
# EMBED_URL=http://127.0.0.1:8089
# EMBED_MODEL=nomic-embed-text-v1.5
# EMBED_ON_DEMAND=true
# QDRANT_COLLECTION=nomad_knowledge_base
# QDRANT_VECTOR_SIZE=768

# Ingest throughput (leave empty for defaults; INGEST_EMBED_URLS empty = EMBED_URL)
INGEST_BATCH_SIZE=32
# Cap concurrency to embed-pool slots (often ~2 on a shared GPU host)
INGEST_EMBED_CONCURRENCY=2
INGEST_FILE_CONCURRENCY=1
INGEST_CHUNK_CONCURRENCY=2
INGEST_MAX_ARTICLES=0
EMBED_MAX_CHARS=2000
INGEST_CHUNK_SEMANTIC=false
INGEST_STALL_MINUTES=15
INGEST_SPARSE_REINDEX=idle

# Qdrant upsert resilience (ingest/qdrant_writer.py)
QDRANT_UPSERT_TIMEOUT_SEC=300
QDRANT_UPSERT_RETRIES=6
QDRANT_UPSERT_BACKOFF_SEC=2

# Sidecar lifecycle (rag_admin/sidecar_lifecycle_guard.py)
SIDECAR_ON_DEMAND=true
SIDECAR_STARTUP_TIMEOUT_SEC=900
SIDECAR_RERANK_STARTUP_TIMEOUT_SEC=180
SIDECAR_LIFECYCLE_POLL_SEC=20
SPARSE_SIDECAR_UNIT=sparse-sidecar.service
RERANK_SIDECAR_UNIT=rerank-sidecar.service
SPARSE_INDEX_URL=http://127.0.0.1:18096

# Embed on-demand (ingest/embed_lifecycle.py) — keep false when EMBED_URL is llama-swap
# EMBED_QUERY_ALWAYS_ON / idle timers only apply when EMBED_ON_DEMAND=true (nomic units)
EMBED_STARTUP_TIMEOUT_SEC=120
EMBED_IDLE_STOP_SEC=180
EMBED_IDLE_PAUSED_SEC=30

# Chunking (align tokenizer with embed model when possible)
INGEST_CHUNK_SIZE_TOKENS=512
INGEST_CHUNK_OVERLAP_TOKENS=64
INGEST_CHUNK_TOKENIZER=Qwen/Qwen3-Embedding-4B
INGEST_CHUNK_MIN_TOKENS=100
