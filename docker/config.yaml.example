# Copy to docker/config.yaml and set model paths under /models (host MODELS_DIR).
# llama-swap legacy CUDA image: config at /app/config.yaml, llama-server at /app/llama-server.
#
# Used only with docker compose --profile llama-swap (optional bundled GPU router).
# Production: run llama-swap on a GPU host and set LLAMA_SWAP_URL / EMBED_URL in docker/.env.

healthCheckTimeout: 120

hooks:
  on_startup:
    preload: []

models:
  # Example chat model — replace with your GGUF under MODELS_DIR.
  "chat-demo":
    name: "Chat demo (edit docker/config.yaml)"
    cmd: >
      /app/llama-server
      -m /models/your-chat-model.gguf
      -c 8192
      -ngl 99
      -fa on
      --host 127.0.0.1
      --port ${PORT}
      --jinja
    ttl: 300

  # Qwen3 Embedding 4B (2560-d). Model id must match EMBED_MODEL (embed-pool).
  "embed-pool":
    name: "Qwen3 Embedding 4B (edit GGUF path)"
    cmd: >
      /app/llama-server
      -m /models/qwen3-embedding-4b.gguf
      --embedding
      --pooling last
      -ngl 99
      -c 8192
      --parallel 4
      --host 127.0.0.1
      --port ${PORT}
    ttl: 300

  # Optional intent classifier (enable ENABLE_INTENT_ROUTER + INTENT_MODEL in docker/.env).
  # "intent-mini":
  #   name: "Intent classifier"
  #   cmd: >
  #     /app/llama-server
  #     -m /models/intent/phi-4-mini-instruct.Q4_K_M.gguf
  #     -c 2048
  #     -ngl 0
  #     --host 127.0.0.1
  #     --port ${PORT}
  #   ttl: 600
