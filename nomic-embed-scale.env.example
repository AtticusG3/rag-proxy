# Copy to /opt/ai/config/nomic-embed-scale.env
# Used by nomic-embed@.service and scripts/scale_nomic_embed_pool.py

# Pool sizing (see ingest/embed_pool.py)
NOMIC_POOL_VRAM_PER_INSTANCE_MIB=1024
# embed_pool.py default is 2048 if unset; 6144 is a conservative homelab override
NOMIC_POOL_VRAM_RESERVE_MIB=6144
NOMIC_POOL_PORT_BASE=18089
NOMIC_POOL_MAX_INSTANCES=8
NOMIC_POOL_MIN_INSTANCES=1
NOMIC_POOL_PARALLEL_PER_INSTANCE=16
# Physical GPU the capacity planner probes (nvidia-smi --id). To move embedding to
# another card, set CUDA_VISIBLE_DEVICES in nomic-embed.env and point this at the SAME
# physical card so the planner sizes the pool against the GPU the instances run on.
# The two indexes may differ: CUDA_VISIBLE_DEVICES is the CUDA runtime order,
# NOMIC_POOL_GPU_INDEX is the nvidia-smi order (see docs/deployment.md).
NOMIC_POOL_GPU_INDEX=0

# NOMIC_POOL_PARALLEL is written by scripts/scale_ingest_capacity.py (GPU-tier capped
# from PARALLEL_PER_INSTANCE). Do not set it by hand; nomic-embed@.service loads it
# from nomic-embed-pool.env (and this file after sync).
