[Unit]
Description=BM25 sparse index sidecar for rag-proxy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=kevyn
WorkingDirectory=/home/kevyn/rag-proxy/sidecars/sparse
Environment=PYTHONPATH=/home/kevyn/rag-proxy
ExecStart=/opt/ai/venv-sidecars/bin/python app.py
Restart=on-failure
RestartSec=30
StartLimitBurst=3
StartLimitIntervalSec=600
Environment=SPARSE_PORT=18096
Environment=SPARSE_HOST=127.0.0.1
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=QDRANT_COLLECTION=nomad_knowledge_base
Environment=LOG_LEVEL=INFO
# Every tick rebuilds the whole index from Qdrant. At 1.5M docs that is ~12 min of
# scrolling, so raise this well above the default if the ingest worker already
# reindexes on idle (INGEST_SPARSE_REINDEX).
Environment=SPARSE_REFRESH_SEC=3600
Environment=SPARSE_SCROLL_BATCH=256
# 0 = full corpus. Measured ~6.3 KB/doc: 1.5M docs settles near 9.4 GB with a
# 12.8 GB build peak, and a rebuild briefly holds the old index too.
Environment=SPARSE_MAX_POINTS=0

[Install]
WantedBy=multi-user.target
