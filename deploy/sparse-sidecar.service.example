[Unit]
Description=BM25 sparse index sidecar for rag-proxy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=kevyn
WorkingDirectory=/home/kevyn/rag-proxy/sidecars/sparse
Environment=PYTHONPATH=/home/kevyn/rag-proxy
ExecStart=/opt/ai/venv-sidecars/bin/python app.py
Restart=on-failure
RestartSec=30
StartLimitBurst=3
StartLimitIntervalSec=600
Environment=SPARSE_PORT=18096
Environment=SPARSE_HOST=127.0.0.1
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=QDRANT_COLLECTION=nomad_knowledge_base
Environment=LOG_LEVEL=INFO
# Every tick rebuilds the whole index from Qdrant: ~12 min of scrolling at 1.5M docs.
# This is only a safety net -- the ingest worker already reindexes on idle
# (INGEST_SPARSE_REINDEX) -- so keep it infrequent. Hourly costs a 20% duty cycle.
Environment=SPARSE_REFRESH_SEC=21600
Environment=SPARSE_SCROLL_BATCH=256
# 0 = full corpus. Build still materialises the BM25 CSC on the heap; after
# finalize the sidecar writes the snapshot and reopens it with numpy mmap so
# steady-state RSS is the working set, not the full inverted index + texts.
Environment=SPARSE_MAX_POINTS=0
Environment=SPARSE_INDEX_PATH=/var/lib/rag_proxy/sparse
Environment=SPARSE_MMAP=true
# 0 = all CPUs. Tokenize overlaps the Qdrant scroll on this many threads.
Environment=SPARSE_N_THREADS=0

[Install]
WantedBy=multi-user.target
