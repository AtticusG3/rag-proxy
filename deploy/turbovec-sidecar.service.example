[Unit]
Description=TurboVec dense ANN sidecar for rag-proxy (buster)
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=simple
User=kevyn
WorkingDirectory=/home/kevyn/rag-proxy/sidecars/turbovec
Environment=PYTHONPATH=/home/kevyn/rag-proxy
ExecStart=/opt/ai/venv-sidecars/bin/python app.py
Restart=on-failure
RestartSec=30
Environment=TURBOVEC_PORT=18097
Environment=TURBOVEC_HOST=127.0.0.1
Environment=TURBOVEC_DIM=768
Environment=TURBOVEC_BIT_WIDTH=4
Environment=TURBOVEC_INDEX_PATH=/var/lib/rag_proxy/turbovec/index.tvim
Environment=TURBOVEC_AUTO_SAVE=false
Environment=QDRANT_URL=http://127.0.0.1:6333
Environment=QDRANT_COLLECTION=nomad_knowledge_base
Environment=LOG_LEVEL=INFO
Environment=TURBOVEC_SCROLL_BATCH=256

[Install]
WantedBy=multi-user.target
