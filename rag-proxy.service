[Unit]
Description=RAG proxy (OpenAI-compatible upstream + Qdrant context injection)
After=network.target
# Upstream chat/embed are external (LLAMA_SWAP_URL / EMBED_URL). Optional legacy
# nomic-embed starts on demand only when EMBED_ON_DEMAND=true.

[Service]
Type=simple
User=kevyn
WorkingDirectory=/home/kevyn/projects/rag-proxy
EnvironmentFile=-/opt/ai/config/rag-proxy.env
ExecStart=/opt/ai/venv/bin/python rag_proxy.py
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

# Do not cp blindly — run: bash scripts/install-systemd-units.sh

[Install]
WantedBy=multi-user.target
